# of error as a hand-edited CONFORMANCE.md, and check-render says so.
# Asserted by: CD-12, CD-09

#!/usr/bin/env bash
# Registry collection on n1: untagged manifests older than 30 days go.
#
# Tagged manifests never do. `:stable` is what every node follows, and a
# collection that removed the digest a node had not yet pulled would turn
# §14.2's window into a node that cannot update at all (§5.5).
set -euo pipefail

# Zot collects on its own schedule from the gcDelay in its configuration,
# which is rendered from the same threshold. This triggers it rather than
# reimplementing it: the registry owns its storage, and a second collector
# walking the same blobs is a second source for what is garbage.
curl --silent --show-error --fail \
  --request POST "http://10.10.255.1:5000/v2/_zot/ext/gc" \
  || echo 'zot-gc: the registry declined; it collects on its own schedule' >&2

# Container storage on this node, which Zot does not own.
/usr/bin/podman system prune --force --filter until=168h
