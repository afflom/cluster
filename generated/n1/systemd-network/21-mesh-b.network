# @generated by `just render` from model/. Do not edit.
# R1: the model is the single source. A hand-edit here is the same class
# of error as a hand-edited CONFORMANCE.md, and check-render says so.
# Asserted by: CD-01, CD-02, CD-09

# n1 -> n3 over mesh_b, link l13. Direct-attached: no switch, so the
# segment has exactly two endpoints and §4.4 trusts it in full.

[Match]
MACAddress=0c:c4:7a:11:10:02

[Link]
MTUBytes=9000

[Network]
Address=10.10.0.2/31
LinkLocalAddressing=no
IPv6AcceptRA=no

# Direct route to n3. Withdrawn by networkd on carrier loss, at which
# point the metric-200 route on the other mesh interface takes over.
[Route]
Destination=10.10.255.3/32
Gateway=10.10.0.3
Metric=100

# Transit to n2 via n3. One hop more than the direct link, and only
# selected when the direct route is gone.
[Route]
Destination=10.10.255.2/32
Gateway=10.10.0.3
Metric=200

