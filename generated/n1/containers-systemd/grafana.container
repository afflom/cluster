# dashboards (§18)

[Unit]
Description=dashboards (§18)
After=network-online.target
Wants=network-online.target

[Container]
Image=docker.io/grafana/grafana:11.2.0
ContainerName=grafana
PublishPort=10.10.255.1:3000:3000
Volume=/var/lib/grafana:/var/lib/grafana:rw,Z
Volume=/etc/grafana/provisioning:/etc/grafana/provisioning:ro,z

[Service]
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target default.target

