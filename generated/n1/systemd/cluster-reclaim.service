# Devcontainer reclamation (§15.3). Notify at 14 days, archive at 30, purge
# at 90 --- and never purge a dirty workspace. Deleting someone's uncommitted
# work because a timer expired is a betrayal, and a system that does it once
# is never trusted again (§15.2).

[Unit]
Description=Reclaim idle devcontainer sessions
Conflicts=cluster-updater.service

[Service]
Type=oneshot
ExecStart=/usr/bin/cluster-ctl reclaim run

