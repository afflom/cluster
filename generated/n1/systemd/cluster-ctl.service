# The control plane on n1. Session registry, rollout state, and the API the
# web interface speaks to (§16.1).
#
# It binds the mesh loopback. `tailscale serve` publishes it with a real
# certificate from the tailnet's CA, so nothing is opened on the management
# plane and there is no password, session cookie, or auth code anywhere in
# this repository (§16.2).

[Unit]
Description=Cluster control plane
After=network-online.target var-lib-cluster\x2dctl.mount
Wants=network-online.target

[Service]
Type=simple
Environment=CLUSTER_CTL_BIND=10.10.255.1:8080
Environment=CLUSTER_CTL_DB=/var/lib/cluster-ctl/sessions.db
Environment=CLUSTER_AUTHORIZED_LOGINS=afflom
Environment=CLUSTER_PEERS=n3:1:http://10.10.255.3:9101/health,n2:2:http://10.10.255.2:9101/health,n1:3:http://10.10.255.1:9101/health
Environment=CLUSTER_RECLAIM_NOTIFY_DAYS=14
Environment=CLUSTER_RECLAIM_ARCHIVE_DAYS=30
Environment=CLUSTER_RECLAIM_PURGE_DAYS=90
Environment=CLUSTER_SNAPSHOT_REPOSITORY=/var/lib/restic/devcontainers
Environment=CLUSTER_SNAPSHOT_TOOL=restic
Environment=CLUSTER_GITHUB_USER_URL=https://api.github.com/user
Environment=CLUSTER_GITHUB_CLIENT_ID=Iv23liCLUSTERafflom00
Environment=CLUSTER_GITHUB_SCOPES=read:user
Environment=CLUSTER_GITHUB_DEVICE_CODE_URL=https://github.com/login/device/code
Environment=CLUSTER_GITHUB_TOKEN_URL=https://github.com/login/oauth/access_token
Environment=CLUSTER_AUTH_TOKEN_CACHE_TTL_S=300
Environment=CLUSTER_AUTH_VALIDATION_TIMEOUT_S=10
Environment=CLUSTER_ALLOWED_ORIGIN=https://afflom.github.io
Environment=CLUSTER_WEB_ROOT=/var/lib/cluster-ctl/web
Environment=CLUSTER_RECLAIM_SUSPEND_DURING_ROLLOUT=true
Environment=CLUSTER_MIGRATION_TARGET=n1
Environment=CLUSTER_MIGRATION_MEMORY_CAP_GIB=12
Environment=CLUSTER_NEVER_RECEIVES=n3
Environment=CLUSTER_STOP_GRACE_S=30
ExecStart=/usr/bin/cluster-ctl serve
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target

