{
  "default": [{ "type": "reject" }],
  "transports": {
    "docker": {
      "ghcr.io/afflom/cluster": [
        {
          "type": "sigstoreSigned",
          "fulcio": {
            "caPath": "/etc/containers/fulcio_ca.pem",
            "oidcIssuer": "https://token.actions.githubusercontent.com",
            "subjectEmail": "https://github.com/afflom/cluster/.github/workflows/promote.yml@refs/heads/main"
          },
          "rekorPublicKeyPath": "/etc/containers/rekor.pub",
          "signedIdentity": { "type": "matchRepository" }
        }
      ]
    }
  }
}
