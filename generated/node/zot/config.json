{
  "distSpecVersion": "1.1.0",
  "storage": { "rootDirectory": "/var/lib/registry", "gc": true,
    "gcDelay": "720h", "gcInterval": "24h" },
  "http": { "address": "10.10.255.1", "port": "5000" },
  "log": { "level": "info" },
  "extensions": {
    "sync": {
      "enable": true,
      "registries": [
        {
          "urls": ["https://ghcr.io"],
          "onDemand": false,
          "pollInterval": "5m",
          "content": [{ "prefix": "/afflom/cluster/**" }]
        },
        {
          "urls": ["https://ghcr.io"],
          "onDemand": true,
          "tlsVerify": true
        },
        {
          "urls": ["https://docker.io"],
          "onDemand": true,
          "tlsVerify": true
        }
      ]
    }
  }
}
