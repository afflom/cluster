#!/usr/bin/env bash
# @generated by `just render` from model/. Do not edit.
# R1: the model is the single source. A hand-edit here is the same class
# of error as a hand-edited CONFORMANCE.md, and check-render says so.
# Asserted by: CD-12, CW-02, CD-09, CD-16
# One ephemeral runner registration for the `testbed` role, one job at a time.
#
# The unit restarts this after every job, which is what makes draining a
# matter of not re-registering rather than of killing work: stopping the
# unit lets the job in flight finish and takes the runner out of rotation
# (§14.1).
set -euo pipefail

# RUNNER_NAME, RUNNER_LABELS and RUNNER_EPHEMERAL come from the unit;
# RUNNER_TOKEN and RUNNER_URL from the environment file the installer
# writes, so no token is ever in an image (§12.2).
: "${RUNNER_NAME:?the unit sets this}"
: "${RUNNER_LABELS:?the unit sets this}"
: "${RUNNER_URL:?/etc/cluster/runner.env sets this}"
: "${RUNNER_TOKEN:?/etc/cluster/runner.env sets this}"

# One measurement at a time, nothing else (§9.5). A flock rather than a
# convention in a workflow, because a convention is not observable from
# the node --- and §18's bench-contention alert is about exactly this.
exec {lock}>/var/lock/cluster-runner
flock --nonblock --exclusive "$lock" || {
  echo "runner: 1 job(s) already running; not registering" >&2
  exit 0
}

work=/var/lib/cluster-runner/$RUNNER_NAME
mkdir -p "$work"
cd "$work"

# A fresh registration each time. An ephemeral runner is removed by the
# service after its job, so the previous registration is already gone.
./config.sh \
  --url "$RUNNER_URL" \
  --token "$RUNNER_TOKEN" \
  --name "$RUNNER_NAME" \
  --labels "$RUNNER_LABELS" \
  --unattended --replace \
  --ephemeral

# Blocks until one job completes, then exits. The unit restarts us.
exec ./run.sh
