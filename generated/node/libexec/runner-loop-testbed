#!/usr/bin/env bash
# @generated by `just render` from model/. Do not edit.
# R1: the model is the single source. A hand-edit here is the same class
# of error as a hand-edited CONFORMANCE.md, and check-render says so.
# Asserted by: CD-12, CW-02, CD-22, CD-09, CD-16
# One ephemeral runner registration for the `testbed` role, one job at a time.
#
# The unit restarts this after every job, which is what makes draining a
# matter of not re-registering rather than of killing work: stopping the
# unit lets the job in flight finish and takes the runner out of rotation
# (§14.1).
set -euo pipefail

# RUNNER_NAME, RUNNER_LABELS and RUNNER_URL come from the unit, which is
# rendered from the model. The credential is the one thing that is not:
# it is enrolled through the browser after the cluster boots and lands
# in a file only root can read, so no token is in an image, in this
# repository, or in `systemctl show` (§12.2).
: "${RUNNER_NAME:?the unit sets this}"
: "${RUNNER_LABELS:?the unit sets this}"
: "${RUNNER_URL:?the unit sets this}"
pat=$(cat /etc/cluster/runner.pat)

# One measurement at a time, nothing else (§9.5). A flock rather than a
# convention in a workflow, because a convention is not observable from
# the node --- and §18's bench-contention alert is about exactly this.
exec {lock}>/var/lock/cluster-runner
flock --nonblock --exclusive "$lock" || {
  echo "runner: 1 job(s) already running; not registering" >&2
  exit 0
}

# The runner's own copy. `config.sh` writes its registration beside
# itself, and /usr/share/cluster-runner is on the read-only system tree --- so each
# runner works from a copy under /var, which the bootc filesystem
# contract makes writable and persistent (§5.2).
work=/var/lib/cluster-runner/$RUNNER_NAME
if [ ! -x "$work/config.sh" ]; then
  mkdir -p "$work"
  /usr/bin/rsync --archive /usr/share/cluster-runner/ "$work/"
fi
cd "$work"

# Mint a registration token, every time round.
#
# A registration token expires in an hour and an ephemeral runner
# re-registers after every job, so a token written to a node once would
# work until lunchtime and then stop, on a machine nobody is watching.
# What is enrolled is a credential that can mint them; this is where it
# is spent (§9.5, §12.2).
token=$(/usr/bin/curl --silent --show-error --fail --max-time 30 \
  --request POST \
  --header "authorization: Bearer $pat" \
  --header "accept: application/vnd.github+json" \
  "https://api.github.com/repos/afflom/cluster/actions/runners/registration-token" \
  | /usr/bin/jq -r .token)
[ -n "$token" ] && [ "$token" != null ] || {
  echo "runner: the enrolled credential could not mint a registration token" >&2
  exit 1
}

# A fresh registration each time. An ephemeral runner is removed by the
# service after its job, so the previous registration is already gone.
./config.sh \
  --url "$RUNNER_URL" \
  --token "$token" \
  --name "$RUNNER_NAME" \
  --labels "$RUNNER_LABELS" \
  --unattended --replace \
  --ephemeral

# Blocks until one job completes, then exits. The unit restarts us.
exec ./run.sh
