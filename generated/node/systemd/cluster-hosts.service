# Places the rendered hosts file (§4.3).
#
# /etc/hosts cannot be written by a container build: a RUN finds the path
# bind-mounted and busy, and a COPY to it is silently dropped --- the image
# builds clean and ships without the file. Both were observed. The content
# therefore ships at /usr/lib/cluster/hosts, where nothing special-cases
# it, and is placed here.
#
# This is the one thing this repository writes into /etc at runtime, and
# it is a copy of an image file rather than anything computed on the node:
# the three-way merge on update sees a value that only ever changes when
# the image changes (§5.2).

[Unit]
Description=Place the rendered hosts file
Before=network-pre.target nss-lookup.target
Wants=network-pre.target
DefaultDependencies=no
After=local-fs.target
ConditionPathExists=/usr/lib/cluster/hosts

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/install -m 0644 /usr/lib/cluster/hosts /etc/hosts

[Install]
WantedBy=sysinit.target

