# The devcontainer agent on the `node2` role. It starts and stops devcontainers,
# reports
# whether a workspace is dirty, and records an attachment (§15.1, §15.2).
#
# It is the only thing that can answer the dirty question, because it is the
# only thing that can see the worktree --- and §15.2 requires that answer
# immediately before any destructive step rather than from a cache.

[Unit]
Description=Devcontainer agent
After=network-online.target remote-fs.target
Wants=network-online.target
ConditionPathExists=/run/cluster/role.compute

[Service]
Type=simple
Environment=AGENT_BIND=10.10.255.2:8081
Environment=AGENT_NODE=node2
Environment=AGENT_WORKSPACES=/var/lib/devcontainers
Environment=AGENT_HOME=/var/lib/devcontainer-home
Environment=DOCKER_HOST=unix:///run/podman/podman.sock
Environment=AGENT_CONTROL_PLANE=http://10.10.255.1:8080
Environment=AGENT_STOP_GRACE_S=30
Environment=AGENT_FEATURES=
Environment=AGENT_TUNNEL_PREFIX=dc-
Environment=AGENT_TUNNEL_URL_TEMPLATE=https://vscode.dev/tunnel/{name}/{folder}
Environment=AGENT_TUNNEL_BACKOFF_INITIAL_S=2
Environment=AGENT_TUNNEL_BACKOFF_MAX_S=60
Environment=AGENT_PORT_VISIBILITY=private
ExecStart=/usr/bin/devcontainer-agent serve
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target

