# Actions runner ci-1 on the `storage` role. --ephemeral: the runner exits
# after one job, so draining is a matter of not re-registering rather
# than of killing work in flight (§14.1).

[Unit]
Description=Actions runner ci-1
After=network-online.target
Wants=network-online.target
ConditionPathExists=/run/cluster/role.storage

[Service]
Type=simple
Environment=RUNNER_NAME=ci-1
Environment=RUNNER_LABELS=self-hosted,linux,x64,cluster,ci
Environment=RUNNER_EPHEMERAL=true
EnvironmentFile=/etc/cluster/runner.env
ExecStart=/usr/libexec/cluster/runner-loop
Restart=always
RestartSec=15

[Install]
WantedBy=multi-user.target

