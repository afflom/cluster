# What this machine works out about itself: which ports are mesh, whether it
# holds bulk disk, which peer is on which cable, and therefore which ordinal,
# role and addresses are its own (§2.3, §3.1, §3.3, §4.1).
#
# Before networkd, because the units it writes are the ones networkd reads.
#
# A failure here fails the boot. A node that could not classify its ports or
# obtain an ordinal has nothing safe to do next, and one that started its
# services anyway would look healthy while being wrong (§3.1, §21.11).
#
# The timeout is discovery's own (300s) plus a margin: a peer that has not been
# powered on yet is the case §12.1 promises this survives, and a unit killed
# mid-wait would report a misassembled fleet where there was only a slow one.

[Unit]
Description=Work out this node's ordinal, role and addresses
DefaultDependencies=no
After=systemd-udev-settle.service local-fs.target
Wants=systemd-udev-settle.service
Before=systemd-networkd.service network-pre.target
Wants=network-pre.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/cluster-init
TimeoutStartSec=600

[Install]
WantedBy=sysinit.target

