# Actions runner bench-1 on the `testbed` role. --ephemeral: the runner exits
# after one job, so draining is a matter of not re-registering rather
# than of killing work in flight (§14.1).

[Unit]
Description=Actions runner bench-1
After=network-online.target
Wants=network-online.target
ConditionPathExists=/run/cluster/role.testbed
ConditionPathExists=/etc/cluster/runner.pat

[Service]
Type=simple
Environment=RUNNER_NAME=bench-1
Environment=RUNNER_LABELS=self-hosted,linux,x64,cluster,bench
Environment=RUNNER_EPHEMERAL=true
Environment=RUNNER_URL=https://github.com/afflom/cluster
ExecStart=/usr/libexec/cluster/runner-loop-testbed
Restart=always
RestartSec=15
Environment=RUNNER_CONCURRENCY=1

[Install]
WantedBy=multi-user.target

