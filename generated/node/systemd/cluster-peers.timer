# Keeps cluster-peers asking, every 15s (§3.3, §12.1).
#
# A mesh port whose peer has not registered is asked again rather than
# waited on, so no boot and no unit blocks on a machine somebody has yet
# to power on.

[Unit]
Description=Ask again for the peers that have not appeared

[Timer]
OnBootSec=5
OnUnitActiveSec=15
AccuracySec=1

[Install]
WantedBy=timers.target
