# The health predicate, served on this node's mesh loopback. This is how
# nodes observe each other without a lock: §13.2's ordering is a pure
# function of what every peer reports here (§10.1).
#
# The address comes from /run/cluster/node.env, written by cluster-init
# once the ordinal is known: a loopback is derived from an ordinal (§4.1)
# and one image boots all three of them (§8.4). The port is a model fact
# and is here.

[Unit]
Description=Serve the cluster health predicate
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/run/cluster/node.env
ExecStart=/usr/bin/cluster-health serve --bind ${CLUSTER_LOOPBACK}:9101
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target

