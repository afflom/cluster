# Addresses each mesh port as the machine on the far end appears (§3.3).
#
# Ordered before nothing, and that is the point. Waiting on a peer that may
# not be powered on is exactly what must not block a boot: cluster-init did
# both halves once, and the first machine of a fleet sat through the whole
# 300s discovery timeout on each port before sshd started (§12.1).
#
# Restarted for ever. A port with no peer is a cable whose far end has not
# registered yet, so each pass asks briefly and the restart is the patience.

[Unit]
Description=Address the mesh as peers appear
After=systemd-networkd.service
Wants=systemd-networkd.service

[Service]
Type=oneshot
EnvironmentFile=/run/cluster/node.env
ExecStart=/usr/bin/cluster-init peers

[Install]
WantedBy=multi-user.target

