# Publishes the control plane at https://node1.afflom.ts.net (§16.2).
#
# The API binds the mesh loopback, which is reachable from the other two
# nodes and from nowhere an operator is. This is what closes that gap, and
# it opens no inbound port on the management plane: Tailscale is
# outbound-initiated (§16.4).

[Unit]
Description=Publish the control plane on the tailnet
After=tailscaled.service cluster-ctl.service
Requires=cluster-ctl.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/tailscale serve --bg --https=443 http://10.10.255.1:8080
ExecStop=/usr/bin/tailscale serve --https=443 off

[Install]
WantedBy=multi-user.target

