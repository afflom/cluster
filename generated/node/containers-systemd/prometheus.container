# Asserted by: CD-05, CD-09, CD-16

# scrapes the mesh; retention accepted as lossy (§5.6, §18)
#
# Ships on all three machines and starts on the one holding `storage`. A unit
# whose condition is unmet is *skipped*, not failed, which is what lets one
# image boot cleanly into any role (§8.4).

[Unit]
Description=scrapes the mesh; retention accepted as lossy (§5.6, §18)
After=network-online.target
Wants=network-online.target
ConditionPathExists=/run/cluster/role.storage

[Container]
Image=quay.io/prometheus/prometheus:v2.54.1
ContainerName=prometheus
PublishPort=10.10.255.1:9090:9090
Volume=/var/lib/prometheus:/prometheus:rw,Z
Volume=/etc/prometheus:/etc/prometheus:ro,z
Exec=--config.file=/etc/prometheus/prometheus.yml --storage.tsdb.path=/prometheus --storage.tsdb.retention.time=30d

[Service]
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target default.target

