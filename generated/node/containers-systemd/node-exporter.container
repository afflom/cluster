# host metrics on the management plane (§18)
#
# Every role runs this one, so it carries no condition.

[Unit]
Description=host metrics on the management plane (§18)
After=network-online.target
Wants=network-online.target

[Container]
Image=quay.io/prometheus/node-exporter:v1.8.2
ContainerName=node-exporter
PublishPort=9100:9100
Network=host
Volume=/:/host:ro,rslave,z

[Service]
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target default.target

