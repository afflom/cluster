# registry; mirrors ghcr.io/afflom/cluster/* and pull-through caches docker.io and ghcr.io (§5.4)
#
# Ships on all three machines and starts on the one holding `storage`. A unit
# whose condition is unmet is *skipped*, not failed, which is what lets one
# image boot cleanly into any role (§8.4).

[Unit]
Description=registry; mirrors ghcr.io/afflom/cluster/* and pull-through caches docker.io and ghcr.io (§5.4)
After=network-online.target
Wants=network-online.target
ConditionPathExists=/run/cluster/role.storage

[Container]
Image=ghcr.io/project-zot/zot-linux-amd64:v2.1.2
ContainerName=zot
PublishPort=10.10.255.1:5000:5000
Volume=/var/lib/zot:/var/lib/registry:rw,Z
Volume=/etc/zot/config.json:/etc/zot/config.json:ro,z

[Service]
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target default.target

