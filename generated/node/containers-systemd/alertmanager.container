# Asserted by: CD-05, CD-09, CD-16

# delivers to a Tailscale-reachable webhook; no paging integration (§18)
#
# Ships on all three machines and starts on the one holding `storage`. A unit
# whose condition is unmet is *skipped*, not failed, which is what lets one
# image boot cleanly into any role (§8.4).

[Unit]
Description=delivers to a Tailscale-reachable webhook; no paging integration (§18)
After=network-online.target
Wants=network-online.target
ConditionPathExists=/run/cluster/role.storage

[Container]
Image=quay.io/prometheus/alertmanager:v0.27.0
ContainerName=alertmanager
PublishPort=10.10.255.1:9093:9093
Volume=/var/lib/alertmanager:/alertmanager:rw,Z
Volume=/etc/alertmanager:/etc/alertmanager:ro,z

[Service]
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target default.target

