# S3-compatible object store; the sccache backend (§5.4)
#
# Ships on all three machines and starts on the one holding `storage`. A unit
# whose condition is unmet is *skipped*, not failed, which is what lets one
# image boot cleanly into any role (§8.4).

[Unit]
Description=S3-compatible object store; the sccache backend (§5.4)
After=network-online.target
Wants=network-online.target
ConditionPathExists=/run/cluster/role.storage

[Container]
Image=docker.io/dxflrs/garage:v1.0.1
ContainerName=garage
PublishPort=10.10.255.1:3900:3900
PublishPort=10.10.255.1:3903:3903
Volume=/var/lib/garage/meta:/var/lib/garage/meta:rw,Z
Volume=/var/lib/garage/data:/var/lib/garage/data:rw,Z

[Service]
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target default.target

