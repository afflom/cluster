# CPUs 2,3 are isolated by kernel argument; the governor and IRQ affinity
         # are not kernel arguments and are established here, before any workload
         # starts (§8.5).
         #
         # What this unit makes true is constructible and CB- carries it. That the
         # result yields stable measurements is neither constructible nor testable,
         # and §21.1 records why.

[Unit]
Description=Pin the governor and steer interrupts off the isolated CPUs
Before=multi-user.target
DefaultDependencies=no
After=sysinit.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/bash -c 'for g in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do echo performance > $g; done'
ExecStart=/usr/bin/bash -c 'echo 0,1 > /proc/irq/default_smp_affinity'

[Install]
WantedBy=multi-user.target

