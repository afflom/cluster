# @generated by `just render` from model/. Do not edit.
# R1: the model is the single source. A hand-edit here is the same class
# of error as a hand-edited CONFORMANCE.md, and check-render says so.
# Asserted by: CD-08, CD-09, CD-16

# Poll every 600s with up to 120s of jitter. There is no webhook: nodes have
# no inbound reachability from GitHub, and polling adds no attack surface
# (§13.1). The jitter is what makes a simultaneous stale read unlikely
# rather than merely improbable in theory (§13.2).

[Unit]
Description=Poll for a promoted image

[Timer]
OnBootSec=600
OnUnitActiveSec=600
RandomizedDelaySec=120
Persistent=true

[Install]
WantedBy=timers.target

