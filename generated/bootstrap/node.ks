# @generated by `just render` from model/. Do not edit.
# R1: the model is the single source. A hand-edit here is the same class
# of error as a hand-edited CONFORMANCE.md, and check-render says so.
# Asserted by: CD-07, CD-09, CD-16

# The kickstart every machine is installed from. One image means one
# installer and nothing to select at install time (§8.4, §12.1).
#
# It carries no credentials and substitutes nothing. A node comes up
# unenrolled and is given its secrets through the browser, over the LAN,
# after it boots (§12.2, §16.2).
#
# The ISO's SHA-256 is published in the release and verified out of band.
# That checksum is the root of trust: §12.3's signature policy ships inside
# the image, so the first install cannot verify itself (§12.1).

text
firstboot --disable
selinux --enforcing
network --bootproto=dhcp --device=link --activate
rootpw --lock
# Console redirection matches the firmware setting (§2.4).
bootloader --append="console=ttyS1,115200"

# M.2 layout, identical on every node. bootc uses ostree deployments
# rather than A/B partitions, so current and rollback share p3 and there
# is no slot arithmetic (§5.1).
clearpart --all --initlabel --disklabel=gpt
part /boot/efi --fstype=efi --size=1024
part /boot --fstype=xfs --size=1024
part / --fstype=xfs --grow

# Secondary storage, decided here rather than chosen by an operator.
#
# A non-boot block device of at least 1000 GB makes this the storage
# node (§2.3.1). That predicate is measurable now; the compute/testbed
# distinction is not --- it is assigned by the registrar over a network
# that does not exist yet during Anaconda --- so this prepares bulk storage
# where it finds bulk storage and a plain filesystem where it does not.
#
# The data volume is a spinning origin under a **writethrough** dm-cache on
# the sata-ssd.
# Writeback would be faster on write and would make a single non-redundant
# SSD a data-loss mode for the whole origin. Writethrough adds no failure
# mode, and it is what makes §2.5's tolerance of hard power loss true ---
# which unattended reboots depend on (§5.3).
#
# dm-cache over ZFS because it is in-tree: a kernel bump carried by a new
# image must not require rebuilding an out-of-tree module inside an
# immutable host.
%post --erroronfail
set -eu

root_disk=$(lsblk --noheadings --output PKNAME --paths "$(findmnt --noheadings --output SOURCE /)" | head -1)
min_bytes=$(( 1000 * 1000 * 1000 * 1000 ))
bulk=""
cache=""
for dev in $(lsblk --noheadings --nodeps --output PATH); do
  [ "$dev" = "$root_disk" ] && continue
  size=$(blockdev --getsize64 "$dev")
  if [ "$size" -ge "$min_bytes" ]; then bulk="$dev"; else cache="$dev"; fi
done

if [ -n "$bulk" ] && [ -n "$cache" ]; then
  vgcreate vg_data "$bulk"
  lvcreate --extents 100%FREE --name lv_data vg_data
  # §2.2 fallback sizing: 64 GiB, used when the cache device is a
  # partition of the M.2 rather than a second SATA device.
  lvcreate --type cache --cachemode writethrough --cachepolicy smq \
    --chunksize 256K --extents 100%FREE --cachedevice "$cache" vg_data/lv_data
  mkfs.xfs /dev/vg_data/lv_data
elif [ -n "$cache" ]; then
  # No bulk device: this machine will be assigned compute or testbed, and
  # either way its second device carries local state (compute: sata-ssd, testbed: sata-ssd). overlay2 and
  # podman's overlay driver do not function on NFS, which is why the
  # container graph is local on every node and NFS carries data only
  # (§11.2). The two roles name the same device, and the model check
  # requires that: the installer cannot tell them apart.
  mkfs.xfs "$cache"
fi
%end

# The node installs with no credentials and comes up **unenrolled**.
#
# There is nothing to substitute here and nothing withheld. The ISO is a
# release artifact, so a secret placed in one is published to whoever
# downloads it --- and this repository is public (§9.1).
#
# What an unenrolled node has is the control plane, reachable over the LAN.
# The operator opens it in a browser, authenticates with the GitHub App
# device flow --- the one credential checkable without any of the others
# existing --- and enters the rest (§12.2, §16.2):
#
#   ssh_authorized_key --- The operator's SSH public key, enabling SSH, which §16.5 keeps as the way back in when the control plane is the thing that is wrong
#   registry_pull_token --- A GHCR token with read:packages and nothing else, enabling pulling the images §13 applies unattended
#   runner_registration_pat --- A GitHub token with administration:write on this repository, enabling the self-hosted runners, which are what T2 and the browser client's node-served mirror both wait on (§9.5, §16.3)
#   tailnet_auth_key --- A Tailscale auth key, ephemeral and single-use, enabling off-LAN access, and the tailnet the control plane is published on (§4.5, §16.2)
# The node is not considered provisioned until the predicate passes (§12.1).
%post --erroronfail --nochroot
echo 'cluster-health must pass before this node is in service'
%end

reboot
