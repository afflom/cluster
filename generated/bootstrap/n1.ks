# @generated by `just render` from model/. Do not edit.
# R1: the model is the single source. A hand-edit here is the same class
# of error as a hand-edited CONFORMANCE.md, and check-render says so.
# Asserted by: CD-07, CD-09, CD-16

# Kickstart for n1, role storage-ci. The installer substitutes the three
# @@PLACEHOLDER@@ values below from Actions secrets at ISO build time;
# none of them is committed, and CD-07 asserts that (§12.2).
#
# The ISO's SHA-256 is published in the release and verified out of band.
# That checksum is the root of trust: §12.3's signature policy ships inside
# the image, so the first install cannot verify itself (§12.1).

text
firstboot --disable
selinux --enforcing
network --bootproto=dhcp --device=link --activate
rootpw --lock
# Console redirection matches the firmware setting (§2.4).
bootloader --append="console=ttyS1,115200"

# M.2 layout, identical on every node. bootc uses ostree deployments
# rather than A/B partitions, so current and rollback share p3 and there
# is no slot arithmetic (§5.1).
clearpart --all --initlabel --disklabel=gpt
part /boot/efi --fstype=efi --size=1024
part /boot --fstype=xfs --size=1024
part / --fstype=xfs --grow

# The data volume: a sata-hdd origin under a writethrough dm-cache on the
# sata-ssd. Writeback would be faster on write and would make a single
# non-redundant SSD a data-loss mode for the whole 2 TB origin.
# Writethrough adds no failure mode, and it is what makes §2.5's
# tolerance of hard power loss true --- which unattended reboots depend
# on (§5.3).
#
# dm-cache over ZFS because it is in-tree: a kernel bump carried by a new
# image must not require rebuilding an out-of-tree module inside an
# immutable host.
%post --erroronfail
vgcreate vg_data /dev/disk/by-id/sata-hdd
lvcreate --extents 100%FREE --name lv_data vg_data
# §2.2 fallback sizing: 64 GiB, used when the cache device is a
# partition of the M.2 rather than the SATA SSD.
lvcreate --type cache --cachemode writethrough --cachepolicy smq \
  --chunksize 256K --extents 100%FREE --cachedevice /dev/disk/by-id/sata-ssd vg_data/lv_data
mkfs.xfs /dev/vg_data/lv_data
%end

# Injected at ISO build time. Names here, values never.
%post --erroronfail
install -d -m 0700 /root/.ssh
printf '%s\n' '@@AUTHORIZED_KEY@@' > /root/.ssh/authorized_keys
chmod 0600 /root/.ssh/authorized_keys

install -d -m 0700 /etc/containers
printf '%s\n' '@@GHCR_PULL_TOKEN@@' > /etc/containers/auth.json
chmod 0600 /etc/containers/auth.json

# Ephemeral and single-use: the key is spent by this one install (§12.2).
tailscale up --auth-key '@@TAILSCALE_AUTH_KEY@@' --advertise-tags=tag:cluster --advertise-routes=192.168.20.0/24
%end

# The node is not considered provisioned until the predicate passes (§12.1).
%post --erroronfail --nochroot
echo 'cluster-health must pass before n1 is in service'
%end

reboot
