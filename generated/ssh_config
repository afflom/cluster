# Client SSH configuration. The primary client is a Chromebook, which
# cannot build images and should not be assumed to run anything but a
# browser and an SSH client: the developer's working environment is a
# devcontainer on n2, not the Chromebook (§11).

Host *
  ServerAliveInterval 30
  ServerAliveCountMax 4
  PasswordAuthentication no
  KbdInteractiveAuthentication no

# The nodes themselves, by their tailnet names.
#
# Not by address: management addresses come from DHCP (§3.2), so there is
# no per-machine address left to write down. MagicDNS is what makes a node
# reachable at a stable name, and it works identically on the LAN and off
# it (§4.5), which the two entries this replaced did not.

Host node1
  HostName node1.afflom.ts.net
  User root

Host node2
  HostName node2.afflom.ts.net
  User root

Host node3
  HostName node3.afflom.ts.net
  User root

# Devcontainer sessions. The ProxyCommand asks the control plane which node
# currently hosts the session, so an alias survives a migration (§14.3).
#
# When the control plane is unreachable --- n1 rebooting, or the client off
# the tailnet --- the fallback resolves to the last known host recorded in
# ~/.ssh/cluster-sessions. The alias keeps working; only migration-aware
# resolution degrades (§16.5).
Host dc-*
  User vscode
  ProxyCommand sh -c 'host=$(curl --silent --max-time 3 \
    "http://node1.afflom.ts.net:8080/api/sessions/$(echo %h | cut -c4-)/connect" \
    | jq -r .host 2>/dev/null); \
    [ -n "$host" ] && [ "$host" != null ] || \
    host=$(grep "^%h " ~/.ssh/cluster-sessions 2>/dev/null | cut -d" " -f2); \
    exec nc "$host" 22'
