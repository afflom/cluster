# The health predicate, served on n2's mesh loopback. This is how nodes
# observe each other without a lock: §13.2's ordering is a pure function
# of what every peer reports here (§10.1).

[Unit]
Description=Serve the cluster health predicate
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/cluster-health serve --bind 10.10.255.2:9101
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target

