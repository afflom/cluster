# 10.10.255.1:/export/devcontainers on n2. Hard mount: it stalls and recovers cleanly across n1's
# reboot, where a soft mount would return errors to a devcontainer
# mid-write (§14.2).

[Unit]
Description=10.10.255.1:/export/devcontainers at /var/lib/devcontainer-home
After=network-online.target
Wants=network-online.target

[Mount]
What=10.10.255.1:/export/devcontainers
Where=/var/lib/devcontainer-home
Type=nfs4
Options=hard,sec=sys,_netdev

[Install]
WantedBy=remote-fs.target

