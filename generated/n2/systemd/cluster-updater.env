# @generated by `just render` from model/. Do not edit.
# R1: the model is the single source. A hand-edit here is the same class
# of error as a hand-edited CONFORMANCE.md, and check-render says so.
# Asserted by: CD-08, CD-09, CD-16

# The rollout predicate's inputs for n2, rendered from model/policy.toml
# and model/cluster.toml. A node at position 2 applies an update only when
# every earlier peer is already on the target and healthy, and every later
# peer is healthy (§13.2).

CLUSTER_NODE=n2
CLUSTER_ROLE=compute
CLUSTER_UPDATE_POSITION=2
CLUSTER_PEERS=n3:1:http://10.10.255.3:9101/health,n1:3:http://10.10.255.1:9101/health
CLUSTER_POLL_INTERVAL_S=600
CLUSTER_POLL_JITTER_S=120
CLUSTER_RECHECK_BEFORE_APPLY_S=30
CLUSTER_PEER_HEALTH_TIMEOUT_S=5
CLUSTER_REGISTRIES=10.10.255.1:5000,ghcr.io
CLUSTER_IMAGE=ghcr.io/afflom/cluster/n2
CLUSTER_STABLE_TAG=stable
CLUSTER_CONTROL_PLANE=http://10.10.255.1:8080

# Drain budgets (§14.4). A budget is never met by force: exceeding one
# halts the rollout and asks for a human.
CLUSTER_BUDGET_BENCH_JOB_S=14400
CLUSTER_BUDGET_BENCH_JOB_ON_EXCEED=halt
CLUSTER_BUDGET_CI_JOB_S=3600
CLUSTER_BUDGET_CI_JOB_ON_EXCEED=halt
CLUSTER_BUDGET_DEVCONTAINER_MIGRATION_S=600
CLUSTER_BUDGET_DEVCONTAINER_MIGRATION_TOTAL_S=1800
CLUSTER_BUDGET_DEVCONTAINER_MIGRATION_ON_EXCEED=stop-with-notice
CLUSTER_BUDGET_TOTAL_S=21600
CLUSTER_BUDGET_TOTAL_ON_EXCEED=halt

# Migration (§14.3).
CLUSTER_MIGRATION_TARGET=n1
CLUSTER_MIGRATION_MEMORY_CAP_GIB=12
CLUSTER_NEVER_RECEIVES=n3
CLUSTER_STOP_GRACE_S=30
