# Runs for every SSH session on n2, interactive or not (§15.1).
#
# scp, rsync and a VS Code server starting are all attachments, and none of
# them sources a profile --- which is why this is sshrc and not profile.d.
#
# Failure is ignored on purpose. A control plane that is rebooting must not
# stop somebody logging in; the cost is one attachment not recorded, and
# §15.3's thresholds are in days (§16.5).
if [ -n "${CLUSTER_SESSION:-}" ]; then
  /usr/bin/curl --silent --fail --max-time 2 --request POST \
    "http://10.10.255.1:8080/api/sessions/${CLUSTER_SESSION}/attached" >/dev/null 2>&1 || true
fi
