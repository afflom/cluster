# n2's mesh loopback. Every mesh service binds this address, which
# decouples service addressing from which link carries a flow and makes
# reachability assertions meaningful (§4.1).
#
# Matched by name and not by MAC: the loopback has no card. CD-01 is
# worded to cover physical interfaces for exactly this reason.

[Match]
Name=lo

[Network]
Address=10.10.255.2/32

