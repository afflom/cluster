# @generated by `just render` from model/. Do not edit.
# R1: the model is the single source. A hand-edit here is the same class
# of error as a hand-edited CONFORMANCE.md, and check-render says so.
# Asserted by: CD-01, CD-02, CD-09, CD-16

# n2 -> n1 over mesh_a, link l12. Direct-attached: no switch, so the
# segment has exactly two endpoints and §4.4 trusts it in full.

[Match]
MACAddress=0c:c4:7a:12:10:01

[Link]
MTUBytes=9000

[Network]
Address=10.10.0.1/31
LinkLocalAddressing=no
IPv6AcceptRA=no

# Direct route to n1. Withdrawn by networkd on carrier loss, at which
# point the metric-200 route on the other mesh interface takes over.
[Route]
Destination=10.10.255.1/32
Gateway=10.10.0.0
Metric=100

# Transit to n3 via n1. One hop more than the direct link, and only
# selected when the direct route is gone.
[Route]
Destination=10.10.255.3/32
Gateway=10.10.0.0
Metric=200

