# n1 --- storage and CI (SPEC.md §8.4).
#
# Registry, object store, NFS, observability, the control plane, two CI runners,
# and the T2 QEMU host. Last to update, because it carries the machinery needed
# to diagnose a bad one (§2.3).
ARG BASE
FROM ${BASE}

RUN dnf -y install \
      lvm2 device-mapper-persistent-data nfs-utils \
      qemu-kvm libvirt-daemon-kvm edk2-ovmf smartmontools \
 && dnf clean all

# restic is not packaged for EL10 --- checked against this base image, not
# assumed --- and §15.3 names it as the snapshot tool. So it is fetched from its
# upstream release, pinned by version and verified by digest, which is the same
# standard `cargo deny` holds everything arriving through cargo to (R6).
#
# The version and digest are in model/images.toml; CI-06 asserts this matches.
RUN curl --silent --show-error --fail --location \
      "https://github.com/restic/restic/releases/download/v0.19.1/restic_0.19.1_linux_amd64.bz2" \
      --output /tmp/restic.bz2 \
 && echo "f415415624dcc452f2a02b8c33641791a8c6d6d3b65bbb3543fcf9a25151585c  /tmp/restic.bz2" \
      | sha256sum --check --strict \
 && bunzip2 -c /tmp/restic.bz2 > /usr/bin/restic \
 && chmod 0755 /usr/bin/restic \
 && rm -f /tmp/restic.bz2 \
 && restic version

# podman-compat: podman with the Docker API shim and DOCKER_HOST set. The
# runtime is a model row rather than a bet in this file, and the build fails
# loudly if the declared runtime's packages are unavailable --- it never silently
# substitutes the other one (§8.2).
RUN dnf -y install podman podman-docker && dnf clean all
ENV DOCKER_HOST=unix:///run/podman/podman.sock

COPY cluster-ctl /usr/bin/cluster-ctl
RUN chmod 0755 /usr/bin/cluster-ctl

# Quadlets ship inside the image under /usr/share/containers/systemd/ and
# materialize as units at boot --- the bootc grain exactly (§8.2).
COPY generated/n1/containers-systemd/ /usr/share/containers/systemd/

# Every one of these is mounted read-only by a Quadlet. A container that mounts
# an empty directory starts and stays active, which §10.1's fifth check cannot
# tell from working --- so the configuration ships with the image (§5.4, §18).
COPY generated/n1/zot/ /etc/zot/
COPY generated/n1/prometheus/ /etc/prometheus/
COPY generated/n1/alertmanager/ /etc/alertmanager/
COPY generated/n1/garage/ /etc/garage/
COPY generated/n1/grafana/provisioning/ /etc/grafana/provisioning/
COPY generated/n1/exports /etc/exports

COPY generated/n1/libexec/ /usr/libexec/cluster/
RUN chmod 0755 /usr/libexec/cluster/*

RUN systemctl enable nfs-server.service libvirtd.service lvm2-monitor.service \
      podman.socket cluster-reclaim.timer tailscale-serve.service

RUN bootc container lint
